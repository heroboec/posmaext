{
  "manifest_version": 3,
  "name": "Position Matcher",
  "version": "2.20",
  "description": "Category filter for the bids table",
  "permissions": [
    "storage",
    "tabs"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page-bridge.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "rejection-reasons.js",
        "social-common.js",
        "content.js",
        "social-content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Position Matcher — настройки и обновления"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  }
}
